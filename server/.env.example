# Copie ce fichier en ".env" et remplis les valeurs. Ne publie jamais le .env sur Git.

# Supabase > Connect > Connection String > "Session pooler"
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Clé secrète pour signer les tokens JWT (une longue chaîne aléatoire)
JWT_SECRET="remplace-moi"

PORT=4000
CLIENT_URL="http://localhost:5173"
